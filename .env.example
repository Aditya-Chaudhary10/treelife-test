# Any OpenAI-compatible endpoint works (Groq, OpenAI, Together, Ollama...).
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_STRONG=openai/gpt-oss-120b     # reasoning-heavy steps (semantic mapping, intent, answers)
LLM_MODEL_FAST=openai/gpt-oss-20b        # cheap steps (file summaries, phrasing)

# Per-call context budget in tokens. Groq free tier allows 8k tokens/min per model.
LLM_CONTEXT_BUDGET=4200

# Local embeddings (no API cost). Set to "none" to run BM25-only.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Where workspaces, caches and generated files live.
DATA_DIR=./data

# --- Task 1: optional real connectors (leave blank to use the built-in messy mock CRM) ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_BASE_URL=https://api.pipedrive.com
HUBSPOT_ACCESS_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
